{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studies Constants Schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Hebrew name of the constant"
      },
      "symbol": {
        "type": "string",
        "description": "Typst math mode compatible symbol string"
      },
      "value": {
        "type": "number",
        "description": "Calculated raw numeric value"
      },
      "units": {
        "type": "string",
        "description": "Typst math mode compatible units string using upright letters"
      },
      "formatted_value": {
        "type": "string",
        "description": "Formatted string value for Typst output"
      }
    },
    "required": [
      "name",
      "symbol",
      "value",
      "units",
      "formatted_value"
    ]
  }
}