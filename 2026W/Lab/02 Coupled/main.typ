= נספח I: פיתוח המשוואות הדיפרנציאליות <נספח>
#let x1=$x_1$
#let x2=$x_2$
#let dx1=$dot(x_1)$
#let dx2=$dot(x_2)$
#let ddx1=$accent(x_1, diaer)$
#let ddx2=$accent(x_2, diaer)$

נסמן את מיקומי המתנדים השמאלי והימני ב־$x1$ וב־$x2$ בהתאמה הנמדדים במטרים. אז משוואות התנועה לפי החוק השני של ניוטון, חוק הוק ומשוואת החיכוך הקינמטי הן:
#let om0 = $omega_0$
$ m ddx1 = -k x1 + k(x2-x1)-Gamma dx1 => dx1 = -2om0^2 x1 + om0^2x2 - Gamma m dx1 $
$ m ddx2 = -k x2 + k(x1-x2)-Gamma m dx2 => dx2 = -2om0^2 x2 + om0^2x1 - Gamma dx2 $
כאשר $m$ היא מסת המתנדים $[k g]$, $k$ קבוע הקפיצים $[N slash m]$, $Gamma$ מקדם הריסון $["rad" slash s]$, ו־$om0$ התדירות העצמית של המתנדים $[1 slash s]$. ממשוואות התנועה נקבל:
$ x1 + x2 = -om0(x1+x2)-Gamma(dx1+dx2) $ <סכום>
$ x1 - x2 = -3om0(x1-x2)-Gamma(dx1-dx2) $ <הפרש>
נשתמש בכתיב פאזורי ונגדיר פיתרון:
$ x1+x2 prop Re[e^(i omega_1 t)] $
נציב ב@סכום ונקבל:
$ -omega_1^2 cancel(e^(i omega_1 t)) = -om0^2cancel(e^(i omega_1 t))-i Gamma cancel(e^(i omega_1 t))omega_1 =>
omega_(1plus.minus) = (i Gamma plus.minus sqrt(-Gamma^2+4om0^2))/2 = Gamma/2 i plus.minus underbrace(sqrt(-Gamma^2/4+om0^2), omega_l) $
נניח שהריסון חלש, ואז האיבר בתוך השורש ממשי. #linebreak()
כעת נניח כי החלק המדומה של הפיתרון שהגדרו אפס ואז:
$ x1+x2 = (A cos(omega_l t) + B sin(omega_l t))e^(-Gamma/2)t $

נשתמש בכתיב פאזורי ונגדיר פיתרון:
$ x1-x2 prop Re[e^(i omega_2 t)] $
נציב ב@הפרש ונקבל:
$ -omega_2^2 cancel(e^(i omega_2 t)) = -3om0^2cancel(e^(i omega_2 t))-i Gamma cancel(e^(i omega_2 t))omega_2 => omega_2^2 - i Gamma omega_2 -3 om0^2=0 $
$ omega_(2plus.minus) = (Gamma i plus.minus sqrt(-Gamma^2+12om0^2))/2 = Gamma/2 i plus.minus underbrace(sqrt(-Gamma^2/4+3om0^2), omega_h) $
נניח שהריסון חלש, ואז האיבר בתוך השורש ממשי. #linebreak()
כעת נניח כי החלק המדומה של הפיתרון שהגדרו אפס ואז:
$ x1-x2 = (C cos(omega_h t) + D sin(omega_h t))e^(-Gamma/2)t $

נסמן $tau = 1/Gamma [s]$ ונקבל את מיקומי המתנדים:
$ vec(x1(t),x2(t)) =e^(-t/(2tau)) = &vec(1,1)(A cos omega_l t+B sin omega_l t ) + \ &vec(1,-1)(C cos omega_h t+D sin omega_h t ) $
$qed$

