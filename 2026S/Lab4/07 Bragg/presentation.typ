// ==========================================
// SLIDE 3: Theoretical Background
// ==========================================
#slide_header("עקרון עקיפת בראג וקרינת רנטגן אופיינית")

#grid(
  columns: (1.2fr, 1fr),
  column-gutter: 12pt,
  card(title: "עקרונות פיזיקליים מרכזיים")[
    - *קרינת בלימה (Bremsstrahlung):* ספקטרום רציף הנובע מהאטת אלקטרונים המואצים במתח $10-35 "kV"$ אל אנודת המוליבדן (Mo).
    - *קרינה אופיינית:* אלקטרונים מהירים מייננים אלקטרון מקליפה פנימית ($K$). מעבר אלקטרון מרמה גבוהה פולט פוטון באנרגיה בדידה: $h nu = E_"initial" - E_"final"$.
    - *חוק בראג להתאבכות בונה:* קרניים המוחזרות ממישורי גביש במרחק $d$ יוצרות התאבכות בונה כאשר: $2d sin(theta_B) = n lambda$.
    - *חילוץ אנרגיית הפוטון:* $E = (h c n) / (2 d sin theta_B)$.
    - *קבועי הסריג שנבדקו:* "LiF" ($d = 201.4 "pm"$) ו-"KBr" ($d = 329.9 "pm"$).
  ],
  card(title: "איור: עקיפת בראג בגביש")[
    #align(center + horizon)[
      #image("images/bragg_angle.png", width: 95%)
    ]
  ]
)

#pagebreak()

