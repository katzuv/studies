#slide_header("נספח ג': מודל התפשטות שגיאות וחישוב מרכז כובד", category: "נספחים להצגה")

#grid(
  columns: (1fr, 1fr),
  gutter: 12pt,
  card(title: "משוואת התפשטות שגיאת האנרגיה")[
    הגזירה של אי-הוודאות באנרגיה $d E$ כפונקציה של רגישות הגוניומטר הזוויתית ($d theta = 0.05degree$):

    $ d E = abs(- (h c n) / (2 d sin^2 theta) cos theta) d theta $

    - רגישות הרזולוציה גדלה ככל שזווית בראג $theta$ קטנה יותר.
    - בסדרי עקיפה גבוהים ($n=2,3$), $d E / d theta$ קטן יחסית.
  ],
  card(title: "חישוב מרכז הכובד (Centroid)")[
    מרכז הכובד מחושב כממוצע משוקלל של העוצמות לאחר הפחתת רקע ליניארי:

    $ theta_C = (sum_i theta_i (I_i - I_("bg", i))) / (sum_i (I_i - I_("bg", i))) $

    - מספק ממוצע רציף לשיאים רחבים.
    - רגיש לקביעת גבולות האינטגרציה ולסימטריות הפיק.
  ]
)
