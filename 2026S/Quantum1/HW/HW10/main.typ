#שאלה(כותרת: "תיקון מסדר שני", מזהה: <1>, [
  עבור המילטוניאן
  $ H = H_0 + lambda V $
  כאשר $lambda$ פרמטר קטן וחסר יחידות, $H_0$ המילטוניאן עם מצבים עצמיים ${ket(n^((0)))}$ ואנרגיות עצמיות ${E_n^((0))}$, נסמן ב־${ket(n)}, {E_n}$ את המצבים העצמיים והאנרגיות העצמיות של $H$.
  נרשום:
  $ E_n = E_n^((0)) + lambda E_n^((1)) + lambda^2 E_n^((2)) + dots $
  $ ket(n) = ket(n^((0))) + lambda ket(n^((1))) + lambda^2 ket(n^((2))) + dots $
  מצאו את התיקון בסדר שני ב־$lambda$ עבור $ket(n)$, למקרה בו $ket(n^((0)))$ הוא מצב לא מנוון.
])

#שאלה(כותרת: "תורת הפרעות בבור פוטנציאל אינסופי חד־ממדי", מזהה: <2>, [
  נתון המילטוניאן של חלקיק עם מסה $m$ בבור פוטנציאל אינסופי:
  $
    V(x) = cases(
      0 & 0 <= x < L,
      oo & "else"
    )
  $
  מוסיפים להמילטוניאן הפרעה קטנה:
  $ W(x) = alpha cos((2 pi x) / L) $
])

#סעיף(מזהה: <2.א>, [
  חשבו את התיקון מסדר ראשון לכל רמות האנרגיה.
])

#סעיף(מזהה: <2.ב>, [
  מצאו את אלמנטי המטריצה $braket(phi_n, W, phi_1)$ כאשר $ket(phi_1)$ הוא מצב היסוד, ו־$ket(phi_n)$ הוא המצב העצמי של ההמילטוניאן ברמה $n > 1$.
])

